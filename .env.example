# Copy to .env and fill in real values. .env is gitignored.
# See documentation/voice_ai_eval_plan_v1_descoped.md Appendix B for setup per provider.

# --- Providers (Phase C) ---
DEEPGRAM_API_KEY=
FISH_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=   # path to service-account JSON, or leave blank if using API key
GOOGLE_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=              # for Canopy Orpheus via Replicate

# --- Voting UI / Vercel deploy (Phase F) ---
FORMSPREE_ENDPOINT=               # e.g. https://formspree.io/f/xxxxxxxx
# VERCEL_TOKEN is set in Vercel CLI, not needed here for local dev

# --- Optional: telemetry / caps ---
VEVAL_SPEND_CAP_USD=100           # soft cap; runner refuses to start if exceeded
